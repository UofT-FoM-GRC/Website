---
import type { CollectionEntry } from 'astro:content'
import BlogPostCard from './BlogPostCard.astro'
import ResourceTypedCard from './ResourceTypedCard.astro'
import { currentResourceSections, isArchivedSection, visibleResourceCards } from '../utils/resourceContent'

interface Props {
	resource: CollectionEntry<'resources'>
	posts: CollectionEntry<'blog'>[]
}

const { resource, posts } = Astro.props
const { sections } = resource.data
const columns = { 1: '', 2: 'md:grid-cols-2', 3: 'md:grid-cols-2 lg:grid-cols-3' }
const hasRelatedPosts = posts.length > 0
---

<main id="main-content" data-pagefind-body class="container mx-auto min-h-screen px-4 py-8">
	<h1 class="mb-8 text-center text-4xl font-bold text-slate-900 dark:text-slate-100">{resource.data.title}</h1>
	<nav
		class="mb-12 rounded-lg bg-white p-6 shadow-md transition-colors dark:bg-slate-800 dark:shadow-slate-900/50"
		aria-label="Quick navigation"
	>
		<h2 class="mb-4 text-2xl font-bold text-slate-900 dark:text-slate-100">Quick Navigation</h2>
		<ul class="space-y-2">
			{
				currentResourceSections(sections).map((section) => (
					<li class="transition-all hover:translate-x-2">
						<a
							href={`#${section.id}`}
							class="flex items-center space-x-2 text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300"
						>
							<>
								<span aria-hidden="true">→</span>
								<span>{section.title}</span>
							</>
						</a>
					</li>
				))
			}
			{
				hasRelatedPosts && (
					<li class="transition-all hover:translate-x-2">
						<a
							href="#blog"
							class="flex items-center space-x-2 text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300"
						>
							<>
								<span aria-hidden="true">→</span>
								<span>Related Blog Posts</span>
							</>
						</a>
					</li>
				)
			}
		</ul>
	</nav>
	{
		sections.map((section) => (
			<section
				id={section.id}
				class="mb-12 scroll-mt-24"
				data-pagefind-ignore={isArchivedSection(section) ? '' : undefined}
			>
				<h2 class="mb-6 text-2xl font-bold text-slate-900 dark:text-slate-100">{section.title}</h2>
				{isArchivedSection(section) && (
					<aside class="mb-6 rounded border-l-4 border-amber-600 bg-amber-50 p-4 text-amber-950 dark:bg-amber-950 dark:text-amber-50">
						<strong>Archived section.</strong> {section.archiveNotice}
						{section.replacement && (
							<p class="mt-2">
								<a href={section.replacement.url} class="text-blue-600 hover:underline dark:text-blue-400">
									{section.replacement.label}
								</a>
							</p>
						)}
					</aside>
				)}
				{!isArchivedSection(section) && (
					<>
						{section.intro.map((paragraph) => (
							<p class="mb-4 max-w-[75ch] leading-relaxed text-slate-700 dark:text-slate-300">{paragraph}</p>
						))}
						<div class:list={['grid gap-6', columns[section.columns]]}>
							{visibleResourceCards(section.cards).map((card) => (
								<ResourceTypedCard card={card} />
							))}
						</div>
					</>
				)}
			</section>
		))
	}
	{
		hasRelatedPosts && (
			<section id="blog" class="my-12 scroll-mt-24">
				<h2 class="mb-4 text-center text-2xl font-bold text-slate-900 dark:text-slate-100">Related Blog Posts</h2>
				<ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
					{posts.map((post) => (
						<BlogPostCard post={post} />
					))}
				</ul>
			</section>
		)
	}
</main>

<style>
	html {
		scroll-behavior: smooth;
	}
</style>
