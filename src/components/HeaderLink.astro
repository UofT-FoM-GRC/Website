---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'a'>

const { href, class: className, ...props } = Astro.props

const { pathname } = Astro.url
const subpath = pathname.match(/[^\/]+/g)
// A link is current on its own page (with or without the trailing slash) and, for one-segment links, on pages under it.
const isActive = href === pathname || href === pathname.replace(/\/$/, '') || href === '/' + subpath?.[0]
---

<a
	href={href}
	class:list={[className, { 'font-semibold after:scale-x-100!': isActive }]}
	{...props}
	aria-current={isActive ? 'page' : undefined}
>
	<slot />
</a>
