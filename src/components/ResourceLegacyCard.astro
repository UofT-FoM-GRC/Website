---
import { resolveCmsAsset } from '../utils/cmsAssets'
import type { LegacyResourceCard } from '../schemas'
import ResourceContactDetails from './ResourceContactDetails.astro'
import ResourceContactPanel from './ResourceContactPanel.astro'
import ResourceStepList from './ResourceStepList.astro'

/** Temporary compatibility renderer for unmigrated resource pages until ticket 10. */

interface Props {
	card: LegacyResourceCard
}

const { card } = Astro.props
---

<article
	class:list={[
		card.variant !== 'plain' &&
			'rounded-lg bg-white p-6 shadow-md transition-colors dark:bg-slate-800 dark:shadow-slate-900/50'
	]}
>
	{
		card.image && (
			<img
				src={resolveCmsAsset(card.image)}
				alt={card.imageAlt || ''}
				loading="lazy"
				decoding="async"
				class="mb-4 h-48 w-full rounded-lg object-cover"
			/>
		)
	}
	<h3 class="mb-3 text-xl font-semibold text-slate-900 dark:text-slate-100">{card.title}</h3>
	{card.text.map((paragraph) => <p class="mb-4 text-slate-700 dark:text-slate-300">{paragraph}</p>)}
	{
		(card.bullets ?? []).length > 0 && (
			<ul class="mb-4 list-disc space-y-2 pl-5 text-slate-700 dark:text-slate-300">
				{(card.bullets ?? []).map((bullet) => (
					<li>{bullet}</li>
				))}
			</ul>
		)
	}
	{(card.listItems ?? []).length > 0 && <ResourceStepList items={card.listItems} listStyle={card.listStyle} />}
	<ResourceContactDetails addressLines={card.addressLines} facts={card.facts} />
	{
		(card.groups ?? []).length > 0 && (
			<div class="mb-4 grid gap-6 md:grid-cols-2">
				{(card.groups ?? []).map((group) => (
					<ResourceContactPanel panel={group} />
				))}
			</div>
		)
	}
	<div class="flex flex-col items-start gap-2">
		{
			card.links.map((link) => (
				<a
					href={link.url}
					class:list={
						card.linkStyle === 'button'
							? 'inline-block rounded bg-blue-600 px-4 py-2 text-white transition-colors hover:bg-blue-700 dark:bg-blue-700 dark:hover:bg-blue-800'
							: 'text-blue-600 hover:underline dark:text-blue-400'
					}
				>
					{link.label}
				</a>
			))
		}
	</div>
</article>
