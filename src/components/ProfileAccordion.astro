---
import { Icon } from 'astro-icon/components'
import ProfileCard from './ProfileCard.astro'

export type ProfileAccordionItem = {
	year: string
	current: boolean
	members: Profile[]
}

type Profile = {
	name: string
	position: string
	image?: string
	imageAlt?: string
}

interface Props {
	item: ProfileAccordionItem
}

const { item } = Astro.props
const contentId = `accordion-content-${item.year.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`
---

<div x-data={`{ open: ${item.current} }`} class="my-4">
	<button
		@click="open = !open"
		class="focus-visible:ring-opacity-50 flex w-full items-center justify-between bg-slate-800 px-4 py-2 text-left text-xl font-medium text-gray-100 transition-colors duration-200 focus:outline-none focus-visible:ring focus-visible:ring-gray-500 xl:text-2xl dark:bg-slate-950 dark:text-slate-200"
		:aria-expanded="open.toString()"
		aria-controls={contentId}
	>
		<span>{item.year}</span>
		<Icon name="mdi:chevron-down" class="h-7 w-7 transition-transform duration-200" :class="open ? 'rotate-180' : ''" />
	</button>
	<div
		x-show="open"
		x-cloak
		x-transition
		class="bg-slate-50 p-4 shadow-md transition-colors duration-200 dark:bg-slate-900"
		id={contentId}
	>
		<div class="container mx-auto grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
			{
				item.members.map((profile) => (
					<ProfileCard
						name={profile.name}
						position={profile.position}
						image={profile.image}
						imageAlt={profile.imageAlt}
					/>
				))
			}
		</div>
	</div>
</div>
