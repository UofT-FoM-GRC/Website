---
import ResourceContactDetails from './ResourceContactDetails.astro'

interface Props {
	panel: {
		title: string
		text?: string[]
		addressLines?: string[]
		facts?: Array<{ label: string; value: string; url?: string }>
		links?: Array<{ label: string; url: string }>
	}
}

const { panel } = Astro.props
---

<section>
	<h4 class="mb-3 font-semibold text-slate-900 dark:text-slate-100">{panel.title}</h4>
	{(panel.text ?? []).map((paragraph) => <p class="mb-3 text-slate-700 dark:text-slate-300">{paragraph}</p>)}
	<ResourceContactDetails
		addressLines={panel.addressLines}
		facts={panel.facts}
		addressClass="mb-3 text-slate-700 not-italic dark:text-slate-300"
		factsFirst
	/>
	<div class="flex flex-col items-start gap-2">
		{
			(panel.links ?? []).map((link) => (
				<a href={link.url} class="text-blue-600 hover:underline dark:text-blue-400">
					{link.label}
				</a>
			))
		}
	</div>
</section>
