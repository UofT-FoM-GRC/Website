---
import { resolveCmsAsset } from '../utils/cmsAssets'

interface Props {
	label: string
	title: string
	description: string
	image: string
	imageAlt: string
}

const { label, title, description, image, imageAlt } = Astro.props
---

<!-- The photo band at the top of the inner pages. Anything passed in (such as a search box) sits under the description. -->
<section class="relative isolate flex min-h-[150px] items-center justify-center overflow-hidden px-6 py-7 text-center">
	<img
		src={resolveCmsAsset(image)}
		alt={imageAlt}
		width="1920"
		height="1080"
		fetchpriority="high"
		class="absolute inset-0 -z-20 h-full w-full scale-105 object-cover object-[center_40%] blur-[2px]"
	/>
	<div class="absolute inset-0 -z-10 bg-[#1E3765]/75 dark:bg-[#1E3765]/80" aria-hidden="true"></div>
	<div class="flex w-full flex-col items-center gap-2 text-white [text-shadow:0_1px_12px_rgb(10_20_40/0.35)]">
		<p class="font-mono text-xs font-medium tracking-[0.2em] text-balance text-[#EEF2F8] uppercase md:text-sm">
			{label}
		</p>
		<h1 class="text-3xl leading-tight font-bold md:text-[2.1rem]">{title}</h1>
		<p class="text-base text-balance text-[#F1F4FA] md:text-[17px]">{description}</p>
		<slot />
	</div>
</section>
