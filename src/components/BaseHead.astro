---
interface Props {
	title?: string
	description?: string
	image?: string
	imageAlt?: string
	article?: boolean
	pubDate?: Date
	updatedDate?: Date
	noindex?: boolean
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const {
	title = 'Graduate Representation Committee | Faculty of Medicine, University of Toronto',
	description = 'The official website of the Faculty of Medicine Graduate Representation Committee at the University of Toronto, providing resources and support for graduate students in medical sciences.',
	image = '/assets/uoft-placeholder-default.webp',
	imageAlt = 'Graduate Representation Committee logo',
	article = false,
	pubDate,
	updatedDate,
	noindex = false
} = Astro.props
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />
<link rel="canonical" href={canonicalURL} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${title} RSS feed`} href="/rss.xml" />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex,follow" />}

<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={Astro.url} />
<meta property="og:site_name" content="Graduate Representation Committee" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
<meta property="og:image:alt" content={imageAlt} />
{article && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{article && updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.url)} />
<meta name="twitter:image:alt" content={imageAlt} />

<meta
	name="keywords"
	content="UofT, University of Toronto, Faculty of Medicine, Graduate Students, GRC, Graduate Representation Committee, Medical Sciences, Graduate Education, Student Resources"
/>
<meta name="author" content="Graduate Representation Committee (GRC), Faculty of Medicine" />
<meta name="language" content="English" />
<script is:inline type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "EducationalOrganization",
		"name": "Graduate Representation Committee",
		"parentOrganization": {
			"@type": "EducationalOrganization",
			"name": "Faculty of Medicine, University of Toronto"
		},
		"url": "https://uoftfomgrc.ca",
		"description": "The official website of the Faculty of Medicine Graduate Representation Committee at the University of Toronto"
	}
</script>
