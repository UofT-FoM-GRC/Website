---
import { getEntry } from 'astro:content'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import GRCLogo from '../assets/GRC_Logo.png'
import NavItem from './NavItem.astro'
import SearchModal from './SearchModal.astro'

const navigation = await getEntry('navigation', 'navigation')
if (!navigation) throw new Error('Missing site navigation')
const { links, resourceLabel, resourcePosition = links.length } = navigation.data
// Resources is a plain link to the Resources page, which lists every topic; it sits at the position editors choose.
const items = [
	...links.slice(0, resourcePosition),
	{ label: resourceLabel, url: '/resources', comingSoon: false },
	...links.slice(resourcePosition)
]
---

<header
	x-data="{ isOpen: false, isDark: document.documentElement.classList.contains('dark') }"
	class="sticky top-0 z-50 bg-[#1E3765] shadow-md transition-colors duration-200 dark:bg-slate-900"
>
	<nav class="flex h-16 items-center justify-between gap-6 px-3 lg:px-10" aria-label="Main navigation">
		<a href="/" class="flex shrink-0 items-center gap-3" aria-label="Go to UofT FoM GRC homepage">
			<span class="logo rounded-full bg-white p-1">
				<Image src={GRCLogo} alt="UofT FoM GRC logo" transition:persist class="h-8 w-8" />
			</span>
			<span class="text-[17px] font-semibold whitespace-nowrap text-white dark:text-slate-100"
				>{navigation.data.brand}</span
			>
		</a>
		<div class="hidden items-center gap-7 lg:flex xl:gap-[30px]">
			{items.map((item) => <NavItem {...item} variant="desktop" />)}
			<button
				@click="$dispatch('open-search', { opener: $el })"
				class="flex items-center text-white hover:text-white/80 dark:text-slate-100"
				aria-label="Open search"><Icon name="mdi:magnify" class="h-6 w-6" /></button
			><button
				@click="isDark = !isDark; $dispatch('toggle-theme')"
				class="flex items-center text-white hover:text-white/80 dark:text-slate-100"
				aria-label="Toggle dark mode"
				:aria-pressed="isDark.toString()"
				><Icon name="mdi:white-balance-sunny" class="h-6 w-6 dark:hidden" /><Icon
					name="mdi:moon-waning-crescent"
					class="hidden h-6 w-6 dark:block"
				/></button
			>
		</div>
		<div class="flex items-center gap-4 lg:hidden">
			<button
				@click="isDark = !isDark; $dispatch('toggle-theme')"
				class="text-white dark:text-slate-100"
				aria-label="Toggle dark mode"
				:aria-pressed="isDark.toString()"
				><Icon name="mdi:white-balance-sunny" class="h-7 w-7 dark:hidden" /><Icon
					name="mdi:moon-waning-crescent"
					class="hidden h-7 w-7 dark:block"
				/></button
			><button
				@click="isOpen = !isOpen"
				class="text-white dark:text-slate-100"
				aria-controls="mobile-menu"
				:aria-label="isOpen ? 'Close mobile menu' : 'Open mobile menu'"
				:aria-expanded="isOpen"><Icon name="mdi:menu" class="h-8 w-8" /></button
			>
		</div>
		<div
			id="mobile-menu"
			x-show="isOpen"
			x-cloak
			@click.away="isOpen = false"
			@keydown.escape.window="isOpen = false"
			class="absolute top-full right-0 left-0 bg-white shadow-md lg:hidden dark:bg-slate-800"
		>
			<div class="flex flex-col p-4">
				{items.map((item) => <NavItem {...item} variant="mobile" />)}<button
					@click="$dispatch('open-search', { opener: $el })"
					class="mt-2 ml-4 flex items-center gap-2 text-slate-800 dark:text-slate-100"
					aria-label="Open search"><Icon name="mdi:magnify" class="h-8 w-8" /><span>Search</span></button
				>
			</div>
		</div>
	</nav>
</header>
<SearchModal />
<script>
	import { toggleTheme } from '../utils/theme'
	window.addEventListener('toggle-theme', () => toggleTheme())
</script>
