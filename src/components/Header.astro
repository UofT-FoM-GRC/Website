---
import { getEntry } from 'astro:content'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import GRCLogo from '../assets/GRC_Logo.png'
import NavItem from './NavItem.astro'
import SearchModal from './SearchModal.astro'

const [navigation, site] = await Promise.all([getEntry('navigation', 'navigation'), getEntry('site', 'site')])
if (!navigation || !site) throw new Error('Missing site navigation')
const instagram = site.data.socialLinks.find((link) => link.network === 'instagram')
// The homepage hero already shows the Instagram and email links, so the header shows them on every other page.
const isHome = Astro.url.pathname.replace(/index\.html$/, '') === '/'
const { links, resourcePosition = links.length } = navigation.data
const linksBeforeResources = links.slice(0, resourcePosition)
const linksAfterResources = links.slice(resourcePosition)
---

<header
	x-data="{ isOpen: false, resourcesOpen: false, isDark: document.documentElement.classList.contains('dark') }"
	class="sticky top-0 z-50 bg-[#1E3765] shadow-md transition-colors duration-200 dark:bg-slate-900"
>
	<nav class="flex items-center justify-between p-2" aria-label="Main navigation">
		<div class="flex items-center gap-2">
			<div class="logo rounded-full bg-white p-1">
				<a href="/" aria-label="Go to UofT FoM GRC homepage"
					><Image src={GRCLogo} alt="UofT FoM GRC logo" transition:persist class="h-10 w-10" /></a
				>
			</div><div
				class="flex items-center text-lg font-bold whitespace-nowrap text-white md:text-xl dark:text-slate-100"
			>
				<a href="/">{navigation.data.brand}</a>
			</div>
		</div>
		<div class="hidden items-center lg:flex">
			{linksBeforeResources.map((link) => <NavItem {...link} variant="desktop" />)}
			<div class="relative">
				<button
					@click="resourcesOpen = !resourcesOpen"
					id="resources-menu-button"
					class="flex items-center gap-1 px-2 py-2 text-sm font-semibold tracking-wider whitespace-nowrap text-white uppercase xl:px-3 dark:text-slate-100"
					aria-controls="resources-menu"
					:aria-expanded="resourcesOpen"
					>{navigation.data.resourceLabel}<Icon
						name="mdi:chevron-down"
						class="h-5 w-5"
						:class="resourcesOpen ? 'rotate-180' : ''"
					/></button
				><div
					x-show="resourcesOpen"
					x-cloak
					id="resources-menu"
					aria-labelledby="resources-menu-button"
					@click.away="resourcesOpen = false"
					@keydown.escape.window="resourcesOpen = false"
					class="absolute right-0 mt-2 w-fit bg-white px-4 shadow-md dark:bg-slate-800"
				>
					{
						navigation.data.resourceLinks.map((link) => (
							<a
								href={`/resources/${link.slug}`}
								class="block px-4 py-2 whitespace-nowrap text-slate-800 hover:bg-slate-200 dark:text-slate-100 dark:hover:bg-slate-700"
							>
								{link.label}
							</a>
						))
					}
				</div>
			</div>
			{linksAfterResources.map((link) => <NavItem {...link} variant="desktop" />)}
			<button
				@click="$dispatch('open-search', { opener: $el })"
				class="flex items-center gap-2 px-2 py-1 text-white dark:text-slate-100"
				aria-label="Open search"
				><Icon name="mdi:magnify" class="h-7 w-7" /><span
					class="hidden text-sm font-semibold tracking-wider uppercase xl:inline">Search</span
				></button
			>
		</div>
		<div class="flex shrink-0 items-center gap-4 px-2 lg:gap-3 xl:gap-4">
			<button
				@click="isDark = !isDark; $dispatch('toggle-theme')"
				class="text-white lg:hidden dark:text-slate-100"
				aria-label="Toggle dark mode"
				><Icon name="mdi:white-balance-sunny" class="h-8 w-8 dark:hidden" /><Icon
					name="mdi:moon-waning-crescent"
					class="hidden h-8 w-8 dark:block"
				/></button
			><button
				@click="isOpen = !isOpen"
				class="text-white lg:hidden dark:text-slate-100"
				aria-controls="mobile-menu"
				:aria-label="isOpen ? 'Close mobile menu' : 'Open mobile menu'"
				:aria-expanded="isOpen"><Icon name="mdi:menu" class="h-8 w-8" /></button
			><button
				@click="isDark = !isDark; $dispatch('toggle-theme')"
				class="hidden text-white lg:block dark:text-slate-100"
				aria-label="Toggle dark mode"
				><Icon name="mdi:white-balance-sunny" class="h-8 w-8 dark:hidden" /><Icon
					name="mdi:moon-waning-crescent"
					class="hidden h-8 w-8 dark:block"
				/></button
			>{
				!isHome && instagram && (
					<a
						href={instagram.url}
						target="_blank"
						rel="noopener noreferrer"
						class="hidden text-white lg:block dark:text-slate-100"
						aria-label={instagram.label}
					>
						<Icon name="mdi:instagram" class="h-8 w-8" />
					</a>
				)
			}{
				!isHome && (
					<a
						href={`mailto:${site.data.contact.email}`}
						class="hidden text-white lg:block dark:text-slate-100"
						aria-label="Email the GRC"
					>
						<Icon name="mdi:email-outline" class="h-8 w-8" />
					</a>
				)
			}
		</div>
		<div
			id="mobile-menu"
			x-show="isOpen"
			x-cloak
			@click.away="isOpen = false"
			@keydown.escape.window="isOpen = false"
			class="absolute top-full right-0 left-0 bg-white shadow-md lg:hidden dark:bg-slate-800"
		>
			<div class="flex flex-col p-4">
				{linksBeforeResources.map((link) => <NavItem {...link} variant="mobile" />)}<button
					@click="resourcesOpen = !resourcesOpen"
					id="mobile-resources-menu-button"
					class="flex w-full items-center justify-between py-2 pr-2 pl-4 text-xl text-slate-800 hover:bg-slate-200 dark:text-slate-100 dark:hover:bg-slate-700"
					aria-controls="mobile-resources-menu"
					:aria-expanded="resourcesOpen"
					>{navigation.data.resourceLabel}<Icon name="mdi:chevron-down" class="h-7 w-7" /></button
				><div id="mobile-resources-menu" x-show="resourcesOpen" x-cloak>
					{
						navigation.data.resourceLinks.map((link) => (
							<a
								href={`/resources/${link.slug}`}
								class="block py-2 pl-6 text-slate-800 hover:bg-slate-200 dark:text-slate-100 dark:hover:bg-slate-700"
							>
								{link.label}
							</a>
						))
					}
				</div>{linksAfterResources.map((link) => <NavItem {...link} variant="mobile" />)}<button
					@click="$dispatch('open-search', { opener: $el })"
					class="mt-2 ml-4 flex items-center gap-2 text-slate-800 dark:text-slate-100"
					aria-label="Open search"><Icon name="mdi:magnify" class="h-8 w-8" /><span>Search</span></button
				>
			</div>
		</div>
	</nav>
</header>
<SearchModal />
<script>
	import { toggleTheme } from '../utils/theme'
	window.addEventListener('toggle-theme', () => toggleTheme())
</script>
