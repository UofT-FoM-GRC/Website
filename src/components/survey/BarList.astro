---
interface Props {
	/** Id for the chart title; the figure is labelled by it. */
	id: string
	title: string
	subtitle: string
	/** One bar per row, in the order given. Values are percentages. */
	rows: { label: string; value: number }[]
	/** Header for the label column in the table view. */
	labelHeading: string
	valueHeading: string
	source: string
	note?: string
}

const { id, title, subtitle, rows, labelHeading, valueHeading, source, note } = Astro.props
const description = `${title}: ${rows.map(({ label, value }) => `${label}, ${value}%`).join('; ')}.`
---

<!-- Horizontal bars with the value at each tip. Every bar is labelled, so there is no axis. -->
<figure data-survey-chart={id} aria-labelledby={id} class="m-0 flex flex-col gap-5">
	<figcaption class="flex flex-col gap-1">
		<span id={id} class="text-xl leading-snug font-bold text-[#13203A] dark:text-slate-100">{title}</span>
		<span class="text-base text-[#4B5872] dark:text-slate-400">{subtitle}</span>
	</figcaption>

	<ul role="img" aria-label={description} class="m-0 flex list-none flex-col gap-3 p-0">
		{
			rows.map((row) => (
				<li
					class="grid gap-x-4 gap-y-1 sm:grid-cols-[minmax(0,17rem)_minmax(0,1fr)] sm:items-center"
					aria-hidden="true"
				>
					<span class="text-[15px] leading-snug text-[#13203A] dark:text-slate-100">{row.label}</span>
					<span class="flex items-center gap-2.5">
						<span
							class="block h-5 min-w-[3px] shrink-0 rounded-r-[4px] bg-[#1E3765] dark:bg-sky-300"
							style={`width: calc((100% - 3.25rem) * ${row.value / 100})`}
						/>
						<span class="text-[15px] font-semibold text-[#13203A] tabular-nums dark:text-slate-100">{row.value}%</span>
					</span>
				</li>
			))
		}
	</ul>

	<details class="rounded-lg border border-[#D6DDE9] dark:border-slate-700">
		<summary
			class="flex min-h-11 cursor-pointer items-center px-4 text-[15px] font-semibold text-[#1E3765] hover:bg-[#F4F6FA] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[#0B6E8A] dark:text-sky-300 dark:hover:bg-slate-800"
		>
			Show as table
		</summary>
		<div class="overflow-x-auto px-4 pb-4">
			<table class="w-full border-collapse text-left text-[15px] text-[#13203A] dark:text-slate-100">
				<thead>
					<tr class="border-b border-[#D6DDE9] dark:border-slate-700">
						<th scope="col" class="py-2 pr-4 font-semibold">{labelHeading}</th>
						<th scope="col" class="py-2 text-right font-semibold">{valueHeading}</th>
					</tr>
				</thead>
				<tbody>
					{
						rows.map((row) => (
							<tr class="border-b border-[#EEF2F8] last:border-0 dark:border-slate-800">
								<th scope="row" class="py-1.5 pr-4 font-normal">
									{row.label}
								</th>
								<td class="py-1.5 text-right tabular-nums">{row.value}%</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</details>

	<p class="m-0 flex flex-col gap-1 text-sm leading-snug text-[#5A6680] dark:text-slate-400">
		{note && <span>{note}</span>}
		<span>Source: {source}</span>
	</p>
</figure>
