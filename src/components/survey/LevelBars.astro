---
interface Props {
	/** Id for the chart title; the figure is labelled by it. */
	id: string
	title: string
	subtitle: string
	/**
	 * Names of the levels from mildest to most severe. The chart fills them left to right
	 * in one blue that darkens with severity; the rest of each bar is the "none" level.
	 */
	levels: [string, string, string]
	/** Label for the unfilled part of each bar, such as "None". */
	noneLabel: string
	/** One bar per row. `levels` are percentages in the same order as the level names. */
	rows: { label: string; none: number; levels: [number, number, number] }[]
	source: string
	note?: string
}

const { id, title, subtitle, levels, noneLabel, rows, source, note } = Astro.props

// One-hue ordinal ramp (blue steps 250 / 450 / 650 in light mode; flipped to 550 / 350 / 150 in dark mode),
// checked with the dataviz palette validator: the lightest step clears 2:1 against the card in each mode.
const levelColours = [
	'bg-[#86b6ef] dark:bg-[#1c5cab]',
	'bg-[#2a78d6] dark:bg-[#5598e7]',
	'bg-[#104281] dark:bg-[#b7d3f6]'
]
const noneColour = 'bg-[#E3E8F0] dark:bg-slate-700'

const total = (row: Props['rows'][number]) => row.levels.reduce((sum, value) => sum + value, 0)
const percent = (value: number) => (value > 0 && value < 1 ? '<1%' : `${Math.round(value)}%`)
const description = `${title}. ${rows
	.map(
		(row) =>
			`${row.label}: ${percent(total(row))} some insecurity (${levels
				.map((level, index) => `${level} ${percent(row.levels[index])}`)
				.join(', ')}; ${noneLabel} ${percent(row.none)})`
	)
	.join('. ')}.`
---

<!-- Stacked bars, one per row: the filled part is "some insecurity", split by level; the grey rest is "none". -->
<figure data-survey-chart={id} aria-labelledby={id} class="m-0 flex flex-col gap-5">
	<figcaption class="flex flex-col gap-1">
		<span id={id} class="text-xl leading-snug font-bold text-[#13203A] dark:text-slate-100">{title}</span>
		<span class="text-base text-[#4B5872] dark:text-slate-400">{subtitle}</span>
	</figcaption>

	<ul
		class="m-0 flex list-none flex-wrap gap-x-5 gap-y-2 p-0 text-sm text-[#2E3A52] dark:text-slate-300"
		aria-hidden="true"
	>
		{
			levels.map((level, index) => (
				<li class="flex items-center gap-2">
					<span class:list={['h-3 w-3 rounded-[3px]', levelColours[index]]} />
					{level}
				</li>
			))
		}
		<li class="flex items-center gap-2">
			<span class:list={['h-3 w-3 rounded-[3px]', noneColour]}></span>
			{noneLabel}
		</li>
	</ul>

	<div role="img" aria-label={description} class="flex flex-col gap-5">
		{
			rows.map((row) => (
				<div class="grid gap-x-4 gap-y-1.5 sm:grid-cols-[8.5rem_minmax(0,1fr)_7.5rem] sm:items-center">
					<span class="text-base font-semibold text-[#13203A] dark:text-slate-100" aria-hidden="true">
						{row.label}
					</span>
					<div class="flex h-6 gap-[2px]" aria-hidden="true">
						{row.levels.map((value, index) => (
							<span
								class:list={['group relative block h-full shrink-0', levelColours[index]]}
								style={`width: ${value}%; min-width: ${value > 0 ? '3px' : '0'}`}
							>
								<span class="pointer-events-none absolute bottom-[calc(100%+0.5rem)] left-1/2 z-10 hidden -translate-x-1/2 rounded-md bg-[#13203A] px-2.5 py-1.5 text-sm whitespace-nowrap text-white shadow-md group-hover:block dark:bg-slate-100 dark:text-slate-900">
									{row.label}, {levels[index].toLowerCase()}: <strong>{percent(value)}</strong>
								</span>
							</span>
						))}
						<span class:list={['group relative block h-full min-w-0 flex-1 rounded-r-[4px]', noneColour]}>
							<span class="pointer-events-none absolute right-0 bottom-[calc(100%+0.5rem)] z-10 hidden rounded-md bg-[#13203A] px-2.5 py-1.5 text-sm whitespace-nowrap text-white shadow-md group-hover:block dark:bg-slate-100 dark:text-slate-900">
								{row.label}, {noneLabel.toLowerCase()}: <strong>{percent(row.none)}</strong>
							</span>
						</span>
					</div>
					<span class="text-base text-[#2E3A52] dark:text-slate-300" aria-hidden="true">
						<strong class="text-lg text-[#13203A] dark:text-slate-100">{percent(total(row))}</strong> some
					</span>
				</div>
			))
		}
	</div>

	<details class="rounded-lg border border-[#D6DDE9] dark:border-slate-700">
		<summary
			class="flex min-h-11 cursor-pointer items-center px-4 text-[15px] font-semibold text-[#1E3765] hover:bg-[#F4F6FA] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[#0B6E8A] dark:text-sky-300 dark:hover:bg-slate-800"
		>
			Show as table
		</summary>
		<div class="overflow-x-auto px-4 pb-4">
			<table class="w-full border-collapse text-left text-[15px] text-[#13203A] dark:text-slate-100">
				<thead>
					<tr class="border-b border-[#D6DDE9] dark:border-slate-700">
						<th scope="col" class="py-2 pr-4 font-semibold"><span class="sr-only">Kind of insecurity</span></th>
						<th scope="col" class="py-2 pr-4 text-right font-semibold">{noneLabel}</th>
						{
							levels.map((level) => (
								<th scope="col" class="py-2 pr-4 text-right font-semibold">
									{level}
								</th>
							))
						}
					</tr>
				</thead>
				<tbody>
					{
						rows.map((row) => (
							<tr class="border-b border-[#EEF2F8] last:border-0 dark:border-slate-800">
								<th scope="row" class="py-1.5 pr-4 font-normal">
									{row.label}
								</th>
								<td class="py-1.5 pr-4 text-right tabular-nums">{percent(row.none)}</td>
								{row.levels.map((value) => (
									<td class="py-1.5 pr-4 text-right tabular-nums">{percent(value)}</td>
								))}
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</details>

	<p class="m-0 flex flex-col gap-1 text-sm leading-snug text-[#5A6680] dark:text-slate-400">
		{note && <span>{note}</span>}
		<span>Source: {source}</span>
	</p>
</figure>
