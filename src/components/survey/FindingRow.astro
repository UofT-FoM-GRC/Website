---
interface Props {
	/**
	 * What sits in the left column: a figure such as "73%" or "3,757", or a step number such as "1".
	 * Step numbers are drawn in a circle so they don't read as results.
	 */
	value: string
	/** Draws a thin bar for a share of respondents (0 to 100). */
	percent?: number
	/** Optional bold first line, for rows that name a theme or a recommendation. */
	title?: string
	text: string
	/** A comparison or follow-up, such as "Up from 8% in 2024". */
	note?: string
	/** Where to check it in the full report, such as "Figure 18". */
	source?: string
	variant?: 'figure' | 'step'
}

const { value, percent, title, text, note, source, variant = 'figure' } = Astro.props
---

<!-- One finding: the figure on the left; the sentence, an optional bar and the report reference on the right. -->
<li data-finding class="grid grid-cols-[5rem_minmax(0,1fr)] gap-x-5 py-5 sm:grid-cols-[6.5rem_minmax(0,1fr)]">
	{
		variant === 'step' ? (
			<span
				class="flex h-10 w-10 items-center justify-center rounded-full bg-[#1E3765] text-lg font-bold text-white dark:bg-sky-300 dark:text-slate-900"
				aria-hidden="true"
			>
				{value}
			</span>
		) : (
			<span class="text-[2rem] leading-none font-bold tracking-tight text-[#1E3765] sm:text-[2.5rem] dark:text-white">
				{value}
			</span>
		)
	}
	<div class="flex min-w-0 flex-col gap-2">
		{title && <p class="m-0 text-lg leading-snug font-bold text-[#13203A] dark:text-slate-100">{title}</p>}
		<p
			class:list={[
				'm-0 leading-snug',
				title ? 'text-base text-[#4B5872] dark:text-slate-300' : 'text-[17px] text-[#13203A] dark:text-slate-100'
			]}
		>
			{text}
		</p>
		{
			percent !== undefined && (
				<span
					data-bar={percent}
					class="mt-1 block h-2 w-full max-w-[28rem] bg-[#E3E8F0] dark:bg-slate-700"
					aria-hidden="true"
				>
					<span class="block h-full rounded-r-[4px] bg-[#1E3765] dark:bg-sky-300" style={`width: ${percent}%`} />
				</span>
			)
		}
		{
			(note || source) && (
				<p class="m-0 flex flex-wrap gap-x-3 gap-y-0.5 text-sm">
					{note && <span class="font-semibold text-[#2E3A52] dark:text-slate-300">{note}</span>}
					{source && <span class="text-[#5A6680] dark:text-slate-400">Report: {source}</span>}
				</p>
			)
		}
	</div>
</li>
