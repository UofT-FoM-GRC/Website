---
import { getEntry } from 'astro:content'
import { Icon } from 'astro-icon/components'
const site = await getEntry('site', 'site')
if (!site) throw new Error('Missing site settings')
const today = new Date()
const iconName = { instagram: 'mdi:instagram', twitter: 'mdi:twitter', github: 'mdi:github' } as const
---

<footer
	class="w-full bg-linear-to-b from-slate-800 to-slate-900 px-4 py-2 text-center text-gray-200 transition-colors duration-200 dark:from-slate-800 dark:to-slate-950 dark:text-slate-300"
>
	<p class="mb-4">
		&copy; {today.getFullYear()} University of Toronto, Faculty of Medicine, Graduate Representation Committee. All rights
		reserved.
	</p><div class="mt-4 flex justify-center gap-4">
		{
			site.data.socialLinks.map((link) => (
				<a
					href={link.url}
					target="_blank"
					rel="noopener noreferrer"
					class="text-gray-200 transition-colors hover:text-gray-300 dark:text-slate-300 dark:hover:text-slate-100"
					aria-label={link.label}
				>
					<Icon name={iconName[link.network]} class="h-8 w-8" />
				</a>
			))
		}
	</div>
</footer>
