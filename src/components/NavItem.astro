---
import HeaderLink from './HeaderLink.astro'

interface Props {
	label: string
	url: string
	/** Shows the label with a "Soon" tag instead of a link, for a page that is not published yet. */
	comingSoon?: boolean
	variant: 'desktop' | 'mobile'
}

const { label, url, comingSoon = false, variant } = Astro.props
const isDesktop = variant === 'desktop'
---

{
	comingSoon ? (
		<span
			data-coming-soon
			class:list={[
				'flex cursor-default items-center gap-1.5 whitespace-nowrap',
				isDesktop
					? 'px-2 py-2 text-sm font-semibold tracking-wider text-white/70 uppercase xl:px-3 dark:text-slate-400'
					: 'py-2 pl-4 text-xl text-slate-500 dark:text-slate-400'
			]}
		>
			{label}
			<span
				class:list={[
					'rounded-full px-1.5 py-0.5 text-[10px] leading-none font-semibold tracking-wide uppercase',
					isDesktop
						? 'bg-white/15 text-white/80 dark:bg-slate-700 dark:text-slate-300'
						: 'bg-slate-200 text-slate-600 dark:bg-slate-700 dark:text-slate-300'
				]}
			>
				<span class="sr-only">coming </span>Soon
			</span>
		</span>
	) : (
		<HeaderLink
			href={url}
			class={
				isDesktop
					? "relative px-2 py-2 text-sm font-semibold tracking-wider whitespace-nowrap text-white uppercase transition-colors after:absolute after:right-2 after:bottom-1 after:left-2 after:h-0.5 after:origin-right after:scale-x-0 after:bg-white after:transition-transform after:duration-300 after:content-[''] hover:after:origin-left hover:after:scale-x-100 xl:px-3 xl:after:right-3 xl:after:left-3 dark:text-slate-100 dark:after:bg-slate-100"
					: 'py-2 pl-4 text-xl text-slate-800 hover:bg-slate-200 dark:text-slate-100 dark:hover:bg-slate-700'
			}
		>
			{label}
		</HeaderLink>
	)
}
