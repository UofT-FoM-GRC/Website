---
import type { CollectionEntry } from 'astro:content'
import FormattedDate from './FormattedDate.astro'

interface Props {
	post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { title, heroImage, pubDate } = post.data
---

<!-- A small card for the Blog page: thumbnail, title and date. Logos and photos both fit whole inside the thumbnail. -->
<li class="flex">
	<a
		href={`/blog/${post.id}/`}
		class="flex grow items-center gap-3.5 rounded-xl border border-[#D6DDE9] bg-white px-4 py-3.5 transition-[border-color,box-shadow] hover:border-[#0B6E8A] hover:shadow-[0_2px_12px_rgb(19_32_58/0.08)] focus-visible:border-[#0B6E8A] focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[#0B6E8A] motion-reduce:transition-none dark:border-slate-700 dark:bg-slate-800 dark:hover:border-sky-400"
	>
		<span
			class="flex h-16 w-24 shrink-0 items-center justify-center overflow-hidden rounded-[10px] border border-[#E3E8F0] bg-white p-1 dark:border-slate-600"
			aria-hidden="true"
		>
			{
				heroImage ? (
					<img
						src={heroImage}
						alt=""
						width="96"
						height="64"
						loading="lazy"
						decoding="async"
						class="h-full w-full object-contain"
					/>
				) : (
					<span class="font-mono text-[11px] tracking-[0.08em] text-[#5A6680] uppercase">GRC</span>
				)
			}
		</span>
		<span class="flex min-w-0 flex-col gap-1">
			<span class="text-base leading-snug font-semibold text-[#13203A] dark:text-slate-100">{title}</span>
			<span class="font-mono text-xs text-[#5A6680] dark:text-slate-400"><FormattedDate date={pubDate} /></span>
		</span>
	</a>
</li>
