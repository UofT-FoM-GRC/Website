---
import BaseHead from '../components/BaseHead.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'

interface Props {
	title?: string
	description?: string
	image?: string
	imageAlt?: string
	article?: boolean
	pubDate?: Date
	updatedDate?: Date
	noindex?: boolean
}

const { title, description, image, imageAlt, article, pubDate, updatedDate, noindex } = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead {title} {description} {image} {imageAlt} {article} {pubDate} {updatedDate} {noindex} />
		<ClientRouter />
		<script is:inline>
			function initializeTheme() {
				let stored = null
				try {
					stored = localStorage.getItem('grc-theme')
				} catch {
					// Storage can be disabled by browser privacy settings.
				}
				document.documentElement.classList.toggle('dark', stored === 'dark')
			}

			initializeTheme()
			document.addEventListener('astro:after-swap', initializeTheme)
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to main content</a>
		<slot name="header">
			<Header />
		</slot>
		<slot />
		<slot name="footer">
			<Footer />
		</slot>
	</body>
</html>
