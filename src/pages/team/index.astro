---
import { getEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageBand from '../../components/PageBand.astro'
import RuledSection from '../../components/RuledSection.astro'
import TeamMemberCard from '../../components/TeamMemberCard.astro'
import TeamMemberChip from '../../components/TeamMemberChip.astro'
import { executivesFirst, isAdvisor, shortYear } from '../../utils/team'

const team = await getEntry('team', 'team')
if (!team) throw new Error('Missing team content')
const { teamPage, years, currentYear } = team.data
const current = years.find(({ year }) => year === currentYear)!
const executives = current.members.filter((member) => !isAdvisor(member))
const advisors = current.members.filter(isAdvisor)
const pastYears = years
	.filter(({ year }) => year !== currentYear)
	.map((year) => {
		const members = executivesFirst(year.members)
		const faces = members.filter(({ image }) => image).slice(0, 4)
		return { ...year, members, faces, more: members.length - faces.length }
	})
---

<BaseLayout title={teamPage.title} description={teamPage.description}>
	<main id="main-content" data-pagefind-body class="bg-[#F4F6FA] dark:bg-slate-900">
		<PageBand {...teamPage} />

		<div class="mx-auto flex max-w-[908px] flex-col gap-11 px-5 py-12 md:px-6 md:py-14">
			<RuledSection id="current-team-heading" title={shortYear(currentYear)} tag="Current team">
				<div class="flex flex-col gap-9">
					{
						executives.length > 0 && (
							<div class="flex flex-col gap-5">
								<div class="flex items-center gap-4">
									<h3 class="font-mono text-[13px] font-medium tracking-[0.12em] text-[#1E3765] uppercase dark:text-slate-200">
										Executive team
									</h3>
									<div class="h-px grow bg-[#D6DDE9] dark:bg-slate-700" aria-hidden="true" />
								</div>
								<ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-3">
									{executives.map((member) => (
										<TeamMemberCard {...member} />
									))}
								</ul>
							</div>
						)
					}
					{
						advisors.length > 0 && (
							<div class="flex flex-col gap-5">
								<div class="flex items-center gap-4">
									<h3 class="font-mono text-[13px] font-medium tracking-[0.12em] text-[#1E3765] uppercase dark:text-slate-200">
										Advisors
									</h3>
									<div class="h-px grow bg-[#D6DDE9] dark:bg-slate-700" aria-hidden="true" />
								</div>
								<ul class="grid grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-3">
									{advisors.map((member) => (
										<TeamMemberChip {...member} />
									))}
								</ul>
							</div>
						)
					}
				</div>
			</RuledSection>

			{
				pastYears.length > 0 && (
					<RuledSection id="past-teams-heading" title="Past teams" tone="ink">
						<div class="flex flex-col gap-3">
							{pastYears.map((year) => (
								<details
									data-team-year={year.year}
									class="group/year overflow-hidden rounded-xl border border-[#D6DDE9] bg-white dark:border-slate-700 dark:bg-slate-800"
								>
									<summary class="flex cursor-pointer list-none items-center gap-4 px-5 py-4 hover:bg-[#F8FAFD] focus-visible:outline-3 focus-visible:-outline-offset-3 focus-visible:outline-[#0B6E8A] dark:hover:bg-slate-700/60 [&::-webkit-details-marker]:hidden">
										<span class="text-[19px] font-semibold text-[#1E3765] dark:text-slate-100">
											{shortYear(year.year)}
										</span>
										<span class="font-mono text-xs tracking-[0.08em] text-[#5A6680] uppercase dark:text-slate-400">
											{year.members.length} members
										</span>
										<span class="grow" />
										<span class="team-faces hidden sm:flex" aria-hidden="true">
											{year.faces.map((member, index) => (
												<img
													src={member.image}
													alt=""
													width="30"
													height="30"
													loading="lazy"
													class:list={[
														'h-[30px] w-[30px] rounded-full border-2 border-white object-cover dark:border-slate-800',
														{ '-ml-2': index > 0 }
													]}
												/>
											))}
											{year.more > 0 && (
												<span class="-ml-2 flex h-[30px] w-[30px] items-center justify-center rounded-full border-2 border-white bg-[#DCE4F1] text-xs font-semibold text-[#1E3765] dark:border-slate-800 dark:bg-slate-700 dark:text-slate-200">
													+{year.more}
												</span>
											)}
										</span>
										<span
											class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#EEF2F8] transition-transform duration-200 group-open/year:rotate-180 motion-reduce:transition-none dark:bg-slate-700"
											aria-hidden="true"
										>
											<svg width="14" height="14" viewBox="0 0 14 14" fill="none">
												<path
													d="M3 5l4 4 4-4"
													stroke="currentColor"
													stroke-width="2"
													stroke-linecap="round"
													stroke-linejoin="round"
													class="text-[#1E3765] dark:text-slate-200"
												/>
											</svg>
										</span>
									</summary>
									<ul class="grid grid-cols-1 gap-3.5 px-5 pt-1 pb-5 sm:grid-cols-2 md:grid-cols-3">
										{year.members.map((member) => (
											<TeamMemberChip {...member} />
										))}
									</ul>
								</details>
							))}
						</div>
					</RuledSection>
				)
			}
		</div>
	</main>
</BaseLayout>

<style>
	/* The small row of faces summarizes a folded year; once the year is open, the full list replaces it. */
	details[open] .team-faces {
		display: none;
	}
</style>
