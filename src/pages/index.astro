---
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import { getEntry } from 'astro:content'
import GRCLogo from '../assets/GRC_Logo.png'
import Footer from '../components/Footer.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { isAnnouncementVisible } from '../utils/announcements'
import { resolveCmsAsset } from '../utils/cmsAssets'

const [homepage, site, announcements] = await Promise.all([
	getEntry('homepage', 'homepage'),
	getEntry('site', 'site'),
	getEntry('announcements', 'announcements')
])
if (!homepage || !site || !announcements) throw new Error('Missing homepage settings')
const { hero } = homepage.data
// Hero lines: the first is a small label above the heading, the second is the page heading, and any others sit below it.
const [heroLabel, heroHeading, ...heroTaglines] = hero.lines
const visibleAnnouncements = announcements.data.items.filter((item) => isAnnouncementVisible(item))
const socialIcon = { instagram: 'mdi:instagram', github: 'mdi:github' } as const
const heroSocialLinks = [
	...site.data.socialLinks.map((link) => ({ ...link, icon: socialIcon[link.network], external: true })),
	{ label: 'Email the GRC', url: `mailto:${site.data.contact.email}`, icon: 'mdi:email-outline', external: false }
]
---

<BaseLayout title={site.data.title} description={site.data.description}>
	<main id="main-content" data-pagefind-body class="flex w-full flex-col">
		{
			visibleAnnouncements.length > 0 && (
				<aside aria-label="Announcements">
					{visibleAnnouncements.map((item) => (
						<div class="w-full bg-blue-100 px-4 py-3 text-center text-slate-900 dark:bg-blue-950 dark:text-slate-100">
							<span>{item.text}</span>
							{item.url && (
								<a class="ml-2 text-blue-700 underline dark:text-blue-300" href={item.url}>
									Learn more
								</a>
							)}
						</div>
					))}
				</aside>
			)
		}
		<!-- Full-screen hero: a light wash in the light theme (mood board option A), a UofT-blue tint in the dark theme (option B). -->
		<section
			class="relative isolate flex min-h-[calc(100svh-4.5rem)] w-full items-center justify-center overflow-hidden"
		>
			<img
				src={resolveCmsAsset(hero.image)}
				alt={hero.imageAlt}
				class="absolute inset-0 -z-20 h-full w-full scale-105 object-cover object-[center_45%] blur-[2px]"
				width="1920"
				height="1080"
				fetchpriority="high"
			/>
			<div class="absolute inset-0 -z-10 bg-[#F6F8FB]/60 dark:bg-[#1E3765]/75" aria-hidden="true"></div>
			<div
				class="flex max-w-5xl flex-col items-center gap-4 px-6 py-16 text-center text-[#1E3765] dark:text-white dark:[text-shadow:0_1px_12px_rgb(10_20_40/0.35)]"
			>
				<div
					class="mb-2 flex h-24 w-24 items-center justify-center rounded-full border-2 border-[#1E3765] bg-white shadow-lg md:h-28 md:w-28 dark:border-0"
				>
					<Image src={GRCLogo} alt="" class="h-16 w-16 md:h-20 md:w-20" />
				</div>
				<p
					class="font-mono text-xs font-medium tracking-[0.16em] text-balance text-[#1E3765] uppercase md:text-sm md:tracking-[0.2em] dark:text-[#EEF2F8]"
				>
					{heroLabel}
				</p>
				<h1 class="text-4xl leading-tight font-bold text-balance md:text-5xl">{heroHeading}</h1>
				{heroTaglines.map((line) => <p class="text-lg text-[#2E3A52] md:text-xl dark:text-[#F1F4FA]">{line}</p>)}
				<ul class="mt-3 flex gap-3 [text-shadow:none]" aria-label="GRC social media and email">
					{
						heroSocialLinks.map((link) => (
							<li>
								<a
									href={link.url}
									aria-label={link.label}
									{...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
									class="flex h-11 w-11 items-center justify-center rounded-full border-[1.5px] border-[#1E3765] bg-white/70 text-[#1E3765] transition-colors hover:bg-[#1E3765] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1E3765] dark:border-white dark:bg-transparent dark:text-white dark:hover:bg-white dark:hover:text-[#1E3765] dark:focus-visible:outline-white"
								>
									<Icon name={link.icon} class="h-5 w-5" />
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</section>
	</main>
	<Footer slot="footer" showLinks={false} />
</BaseLayout>
