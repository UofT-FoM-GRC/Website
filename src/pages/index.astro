---
import { Icon } from 'astro-icon/components'
import { getEntry } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import { resolveCmsAsset } from '../utils/cmsAssets'

const [homepage, site, announcements] = await Promise.all([
	getEntry('homepage', 'homepage'),
	getEntry('site', 'site'),
	getEntry('announcements', 'announcements')
])
if (!homepage || !site || !announcements) throw new Error('Missing homepage settings')
const { hero, featureSections, contactHeading, contactText } = homepage.data
---

<BaseLayout title={site.data.title} description={site.data.description}>
	<main id="main-content" data-pagefind-body class="mx-auto flex w-full flex-col items-center overflow-hidden">
		<section class="fade-in-section relative h-[50vh] min-h-[300px] w-full rounded-t-xl">
			<div class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div><div class="relative h-full w-full">
				<img
					src={resolveCmsAsset(hero.image)}
					alt={hero.imageAlt}
					class="fade-in-image h-full w-full object-cover brightness-50"
					width="1920"
					height="1080"
					fetchpriority="high"
				/>
			</div><div class="fade-in-text absolute inset-0 flex flex-col items-center justify-center space-y-4">
				{
					hero.lines.map((line, index) =>
						index === 1 ? (
							<h1 class="text-center text-5xl font-bold text-white md:text-6xl lg:text-7xl">{line}</h1>
						) : (
							<p class="text-center text-xl font-bold text-white md:text-3xl">{line}</p>
						)
					)
				}
			</div>
		</section>
		{
			announcements.data.items
				.filter((item) => item.active)
				.map((item) => (
					<section class="w-full bg-blue-100 px-4 py-4 text-center text-slate-900 dark:bg-blue-950 dark:text-slate-100">
						<span> {item.text}</span>
						{item.url && (
							<a class="ml-2 text-blue-700 underline dark:text-blue-300" href={item.url}>
								Learn more
							</a>
						)}
					</section>
				))
		}
		{
			featureSections.map((section) => (
				<section
					class:list={[
						'fade-in-section relative flex min-h-120 w-full items-center py-20 transition-colors duration-200',
						section.tone === 'dark' ? 'bg-gray-800 dark:bg-slate-950' : 'bg-slate-50 dark:bg-slate-900'
					]}
				>
					<div class="container mx-auto px-4">
						<div class="flex flex-col items-center gap-8 md:flex-row">
							<>
								<div class:list={['fade-in-image md:w-1/2', section.imageFirst ? 'md:order-1' : 'md:order-2']}>
									<img
										src={resolveCmsAsset(section.image)}
										alt={section.imageAlt}
										width="500"
										height="300"
										loading="lazy"
										decoding="async"
										class="h-auto w-full rounded-lg shadow-md"
									/>
								</div>
								<div class:list={['fade-in-text prose md:w-1/2', section.imageFirst ? 'md:order-2' : 'md:order-1']}>
									<h2
										class:list={[
											'text-4xl font-bold md:text-5xl lg:text-6xl',
											section.tone === 'dark' ? 'text-white dark:text-slate-100' : 'text-slate-900 dark:text-slate-100'
										]}
									>
										{section.title}
									</h2>
									{section.paragraphs.map((paragraph) => (
										<p
											class:list={[
												'text-md mt-4 leading-relaxed md:text-lg lg:text-xl',
												section.tone === 'dark'
													? 'text-gray-200 dark:text-slate-300'
													: 'text-gray-700 dark:text-slate-300'
											]}
										>
											{paragraph}
										</p>
									))}
									{section.links.map((link) => (
										<a href={link.url} class="mr-4 text-lg font-bold text-blue-500 dark:text-blue-400">
											{link.label}
										</a>
									))}
								</div>
							</>
						</div>
					</div>
				</section>
			))
		}
		<section
			class="fade-in-section relative flex min-h-120 w-full flex-col items-center bg-slate-50 py-20 transition-colors duration-200 dark:bg-slate-900"
		>
			<div class="container mx-auto px-4">
				<div class="fade-in-text flex flex-col items-center gap-8">
					<h2 class="text-4xl font-bold text-slate-900 md:text-5xl lg:text-6xl dark:text-slate-100">
						{contactHeading}
					</h2><p class="text-md mt-4 leading-relaxed text-gray-700 md:text-lg lg:text-xl dark:text-slate-300">
						{contactText}
					</p>
				</div><div class="mt-12 flex flex-col items-center gap-8">
					<div class="flex items-center gap-4">
						<Icon name="mdi:email" class="h-12 w-12 text-slate-700 dark:text-slate-300" /><div>
							<h3 class="text-2xl font-bold text-slate-900 dark:text-slate-100">Email</h3><a
								href={`mailto:${site.data.contact.email}`}
								class="text-lg text-blue-500 dark:text-blue-400">{site.data.contact.email}</a
							>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
	<script>
		const observer = new IntersectionObserver(
			(entries, currentObserver) =>
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('visible')
						currentObserver.unobserve(entry.target)
					}
				}),
			{ rootMargin: '0px 0px -50px 0px', threshold: 0.4 }
		)
		const setUpIntersectionObserver = () => {
			document.documentElement.classList.add('motion-ready')
			document.querySelectorAll('.fade-in-section').forEach((section) => {
				const image = section.querySelector('.fade-in-image')
				const text = section.querySelector('.fade-in-text')
				if (image) observer.observe(image)
				if (text) observer.observe(text)
			})
		}
		document.addEventListener('astro:page-load', setUpIntersectionObserver)
		document.addEventListener('DOMContentLoaded', setUpIntersectionObserver)
	</script>
</BaseLayout>

<style>
	.fade-in-section {
		opacity: 1;
		transition:
			opacity 0.5s ease-out,
			transform 0.5s ease-out;
	}
	@media (prefers-reduced-motion: no-preference) {
		:global(.motion-ready) .fade-in-image,
		:global(.motion-ready) .fade-in-text {
			opacity: 0;
			transform: translateY(20px);
			transition:
				opacity 0.5s ease-out,
				transform 0.5s ease-out;
		}
		:global(.motion-ready) .fade-in-image.visible,
		:global(.motion-ready) .fade-in-text.visible {
			opacity: 1;
			transform: translateY(0);
		}
		:global(.motion-ready) .fade-in-text.visible {
			transition-delay: 0.2s;
		}
	}
</style>
