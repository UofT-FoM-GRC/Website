---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
	title="Page not found | Graduate Representation Committee"
	description="The requested page could not be found."
	noindex
>
	<main id="main-content" class="container mx-auto flex min-h-[60vh] items-center px-4 py-16 sm:py-24">
		<div class="max-w-2xl">
			<p class="text-lg font-semibold text-blue-700 dark:text-blue-300">Error 404</p>
			<h1 class="mt-2 text-4xl font-bold text-slate-900 sm:text-5xl dark:text-slate-100">Page not found</h1>
			<p class="mt-5 text-xl text-slate-700 dark:text-slate-300">
				The link may be outdated, or the page may have moved.
			</p>
			<div class="mt-8 flex flex-wrap gap-4">
				<a href="/" class="rounded bg-blue-700 px-5 py-3 font-bold text-white hover:bg-blue-800">Go to homepage</a>
				<a
					href="/resources/"
					class="rounded border border-blue-700 px-5 py-3 font-bold text-blue-800 hover:bg-blue-50 dark:text-blue-300 dark:hover:bg-slate-800"
					>Browse resources</a
				>
				<button
					@click="$dispatch('open-search', { opener: $el })"
					class="rounded border border-blue-700 px-5 py-3 font-bold text-blue-800 hover:bg-blue-50 dark:text-blue-300 dark:hover:bg-slate-800"
					>Search site</button
				>
			</div>
		</div>
	</main>
</BaseLayout>
