---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { BLOG_TAGS } from '../../consts'
import { resolveCmsAsset } from '../../utils/cmsAssets'

const bySlug = new Map((await getCollection('resources')).map((resource) => [resource.data.slug, resource]))
const resources = BLOG_TAGS.map((tag) => bySlug.get(tag)).filter((resource): resource is NonNullable<typeof resource> =>
	Boolean(resource)
)
---

<BaseLayout
	title="Graduate student resources | Graduate Representation Committee"
	description="Browse graduate student resources for employment, funding, wellness, housing, education, and more."
>
	<main id="main-content" data-pagefind-body class="container mx-auto min-h-screen px-4 py-8">
		<section>
			<header class="mb-10 max-w-3xl">
				<h1 class="text-4xl font-bold text-slate-900 dark:text-slate-100">Graduate student resources</h1>
				<p class="mt-3 text-slate-700 dark:text-slate-300">
					Find University of Toronto and community resources organized by graduate-student need.
				</p>
			</header>
			<ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
				{
					resources.map((resource) => (
						<li class="card overflow-hidden rounded-lg bg-white shadow-md transition-colors duration-300 focus-within:ring-2 focus-within:ring-blue-500 hover:-translate-y-1 dark:bg-slate-800 dark:shadow-slate-900/50">
							<a
								href={`/resources/${resource.data.slug}/`}
								class="block focus:outline-none focus-visible:ring-3 focus-visible:ring-blue-500 focus-visible:ring-offset-2"
							>
								<img
									src={resolveCmsAsset(resource.data.cardImage)}
									alt={resource.data.cardImageAlt}
									width="720"
									height="360"
									loading="lazy"
									decoding="async"
									class="aspect-video w-full object-cover object-center"
								/>
								<div class="p-4">
									<h2 class="mb-2 text-xl font-bold text-slate-900 dark:text-slate-100">{resource.data.cardTitle}</h2>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</main>
</BaseLayout>
