---
import { getEntry } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Accordion from '../../components/ProfileAccordion.astro'
import { resolveCmsAsset } from '../../utils/cmsAssets'

const team = await getEntry('team', 'team')
if (!team) throw new Error('Missing team content')
const { about, years } = team.data
---

<BaseLayout title={about.title} description={about.description}>
	<main>
		<section id="about-hero" class="hero">
			<div class="hero_container flex w-full flex-col items-center justify-center">
				<img
					src={resolveCmsAsset(about.heroImage)}
					alt={about.heroImageAlt}
					width="1920"
					height="1080"
					class="hero_image"
				/>
			</div>
			<div class="hero_content prose md:prose-lg dark:prose-invert container mx-auto mt-4 max-w-[120ch] p-4">
				<h1 class="hero_title my-4 text-center text-5xl font-bold text-slate-900 dark:text-slate-100">
					{about.title}
				</h1><p class="hero_description lead text-justify text-slate-700 dark:text-slate-300">{about.description}</p>
			</div>
		</section>
		<section id="about-content" class="fade-in-section container mx-auto max-w-[120ch] px-4 py-8">
			<div class="mb-8 rounded-lg bg-white p-6 shadow-md transition-colors dark:bg-slate-800 dark:shadow-slate-900/50">
				<h2 class="mb-4 text-center text-2xl font-bold text-slate-900 dark:text-slate-100">{about.purposeTitle}</h2>{
					about.purposeParagraphs.map((paragraph) => (
						<p class="mb-4 text-justify text-slate-700 dark:text-slate-300">{paragraph}</p>
					))
				}<ul class="space-y-2 text-slate-700 dark:text-slate-300">
					{
						about.objectives.map((objective) => (
							<li class="flex items-start">
								<>
									<span class="mr-3 text-blue-600 dark:text-blue-400">✓</span>
									<span>{objective}</span>
								</>
							</li>
						))
					}
				</ul>
			</div>
			<div class="mb-8 rounded-lg bg-white p-6 shadow-md transition-colors dark:bg-slate-800 dark:shadow-slate-900/50">
				<h2 class="mb-4 text-center text-2xl font-bold text-slate-900 dark:text-slate-100">{about.workTitle}</h2>{
					about.workParagraphs.map((paragraph) => (
						<p class="text-justify text-slate-700 dark:text-slate-300">{paragraph}</p>
					))
				}
			</div>
		</section>
		<section id="about-team" class="mx-auto p-4 shadow-md">
			<h2 class="mb-12 text-center text-5xl font-bold text-slate-900 dark:text-slate-100">Our Team</h2><div
				class="space-y-3"
			>
				{
					years.map((year) => (
						<div class="rounded-lg bg-white shadow-md transition-colors dark:bg-slate-800 dark:shadow-slate-900/50">
							<Accordion item={year} />
						</div>
					))
				}
			</div>
		</section>
	</main>
</BaseLayout>
